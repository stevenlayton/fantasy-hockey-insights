# Copy to .env.local for local dev (git-ignored). For CI/CD, set these as
# GitHub Actions repo secrets (see .github/workflows/deploy.yml) so they get
# baked in at build time - Vite only exposes vars prefixed VITE_ to the client.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Leave blank until the AdSense account is approved - AdSlot.jsx no-ops
# (renders nothing) when this is unset, so there's no broken-ad placeholder
# shown to visitors in the meantime.
VITE_ADSENSE_CLIENT_ID=

{
  "name": "functions",
  "description": "Cloud Functions for Fantasy Hockey Insights (draftcrease.com) - scheduled NHL stats + news ingestion",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "lint": "echo (no lint configured yet) && exit 0",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "fast-xml-parser": "^4.5.0"
  }
}

# Copy to functions/.env (git-ignored) for local emulation, or set via
# `firebase functions:config` / the Firebase console's env var UI for
# deployed functions.

# Optional. Feed URL from an RSS-generation proxy (RSS.app, FetchRSS,
# politepol.com, etc.) pointed at nhl.com/news. If unset, ingestNews just
# skips NHL.com and uses the other configured sources.
NHL_PROXY_RSS_URL=
